 	int32		result;
 
 	result = numeric_int4_safe(num, fcinfo->context);
@@ -4503,7 +4510,8 @@ numeric_int8_safe(Numeric num, Node *escontext)
 Datum
 numeric_int8(PG_FUNCTION_ARGS)
 {
