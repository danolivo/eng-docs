 	/*
 	 * Handle NaN (infinities can be handled normally)
@@ -1592,7 +1596,8 @@ numeric_sign(PG_FUNCTION_ARGS)
 Datum
 numeric_round(PG_FUNCTION_ARGS)
 {
-	Numeric		num = PG_GETARG_NUMERIC(0);
+	NumericLocalBuf buf;
