 	int64		result;
 
 	result = numeric_int8_safe(num, fcinfo->context);
@@ -4527,7 +4535,8 @@ int2_numeric(PG_FUNCTION_ARGS)
 Datum
 numeric_int2(PG_FUNCTION_ARGS)
 {
