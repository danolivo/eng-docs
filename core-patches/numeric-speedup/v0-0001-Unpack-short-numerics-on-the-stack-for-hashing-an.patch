+	Numeric		num2 = numeric_unpack_local(PG_GETARG_DATUM(1), &buf2, &free2);
 	bool		result;
 
 	result = cmp_numerics(num1, num2) <= 0;
 
-	PG_FREE_IF_COPY(num1, 0);
-	PG_FREE_IF_COPY(num2, 1);
+	if (unlikely(free1))
