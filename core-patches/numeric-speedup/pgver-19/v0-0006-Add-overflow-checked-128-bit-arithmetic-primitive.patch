From 3e1a666fdffcbf697cfdf07ea4f2a5a24ddcdef5 Mon Sep 17 00:00:00 2001
From: "Andrei V. Lepikhov" <lepihov@gmail.com>
Date: Thu, 6 Aug 2026 10:15:41 +0200
Subject: [PATCH v0 06/10] Add overflow-checked 128-bit arithmetic primitives

Provide int128_add_int128_overflow() and int128_mul_pow10_overflow(), which let
numeric aggregates use a 128-bit accumulator. Callers that accumulate values
may detect overflow and fall back to a wider representation.

The existing int128.h primitives silently wrap around on overflow, which is
unacceptable for a caller that accumulates values of unbounded width.

The intended user is a follow-up fast path in the numeric aggregates: they will
sum into a 128-bit accumulator and switch to NumericSumAccum only when it
overflows. int128_mul_pow10_overflow() serves to rescale coefficients to
a common decimal scale.
---
 src/include/common/int128.h                | 244 +++++++++++++++++++++
 src/test/modules/test_int128/test_int128.c | 222 +++++++++++++++++++
 2 files changed, 466 insertions(+)

diff --git a/src/include/common/int128.h b/src/include/common/int128.h
index 7db8aff94d3..57a1388b85c 100644
--- a/src/include/common/int128.h
+++ b/src/include/common/int128.h
@@ -474,4 +474,248 @@ int128_to_int64(INT128 val)
 #endif
 }
 
+/*
+ * Overflow-checked operations.
+ *
+ * These are for callers that must detect overflow and fall back to a wider
+ * representation rather than error out, so on overflow they leave their
+ * target untouched.
+ */
+
+/*
+ * Add an INT128 value into an INT128 variable, checking for overflow.
+ *
+ * Returns true (leaving *i128 unchanged) if the sum does not fit,
+ * otherwise updates *i128 and returns false.
+ */
+static inline bool
+int128_add_int128_overflow(INT128 *i128, INT128 v)
+{
+#if USE_NATIVE_INT128 && defined(HAVE__BUILTIN_OP_OVERFLOW)
+	/*
+	 * Compilers expand a 128-bit add-with-overflow inline (add/adc and a
+	 * flag test), so unlike multiplication this needs no runtime library
+	 * support.
+	 */
+	int128		result;
+
+	if (__builtin_add_overflow(*i128, v, &result))
+		return true;
+	*i128 = result;
+	return false;
+#else
+	/*
+	 * Signed overflow occurs iff the addends have the same sign and the
+	 * result's sign differs from it.  Compute the raw sum entirely in
+	 * unsigned arithmetic (which wraps by definition, so there is no
+	 * undefined behaviour to trip over), then apply the sign rule.
+	 */
+	INT128		result = *i128;
+	bool		lhs_neg = (PG_INT128_HI_INT64(result) < 0);
+	bool		rhs_neg = (PG_INT128_HI_INT64(v) < 0);
+
+#if USE_NATIVE_INT128
+	result = (int128) ((uint128) result + (uint128) v);
+#else
+	{
+		uint64		oldlo = result.lo;
+
+		result.lo += v.lo;
+		result.hi = (int64) ((uint64) result.hi + (uint64) v.hi +
+							 (result.lo < oldlo));
+	}
+#endif
+	if (lhs_neg == rhs_neg &&
+		(PG_INT128_HI_INT64(result) < 0) != lhs_neg)
+		return true;
+	*i128 = result;
+	return false;
+#endif
+}
+
+/*
+ * Largest k for which 10^k is representable in a signed 64-bit integer.
+ */
+#define INT64_POW10_MAX		18
+
+/*
+ * 10^k as int64, for 0 <= k <= INT64_POW10_MAX.  It is up to the caller to
+ * keep the index within that range.
+ */
+static const int64 pow10_int64[INT64_POW10_MAX + 1] = {
+	INT64CONST(1),
+	INT64CONST(10),
+	INT64CONST(100),
+	INT64CONST(1000),
+	INT64CONST(10000),
+	INT64CONST(100000),
+	INT64CONST(1000000),
+	INT64CONST(10000000),
+	INT64CONST(100000000),
+	INT64CONST(1000000000),
+	INT64CONST(10000000000),
+	INT64CONST(100000000000),
+	INT64CONST(1000000000000),
+	INT64CONST(10000000000000),
+	INT64CONST(100000000000000),
+	INT64CONST(1000000000000000),
+	INT64CONST(10000000000000000),
+	INT64CONST(100000000000000000),
+	INT64CONST(1000000000000000000)
+};
+
+/*
+ * Largest k for which 10^k is representable in a signed 128-bit integer.
+ */
+#define INT128_POW10_MAX	38
+
+/*
+ * Multiply an INT128 variable by 10^k, checking for overflow.
+ *
+ * Returns true (leaving *i128 unchanged) if the product does not fit,
+ * otherwise updates *i128 and returns false.  Any k >= 0 is accepted:
+ * zero stays zero, and any other value overflows for k > INT128_POW10_MAX.
+ *
+ * This is the decimal-rescaling primitive: it aligns fixed-point
+ * coefficients to a common scale.
+ *
+ * The overflow test is exact and the same on every platform: v * 10^k fits
+ * iff |v| <= floor((2^127 - 1) / 10^k).  One bound serves both signs,
+ * because 2^127 is not a multiple of 10: no product of 10^k (k > 0) can
+ * equal -2^127, so the extra negative value adds nothing.  Once the bound
+ * holds, the multiplication itself cannot overflow.
+ *
+ * __builtin_mul_overflow() is deliberately not used.  configure only
+ * verifies it for 64-bit operands; for 128-bit operands some compilers emit
+ * a call to a runtime helper (__muloti4) that libgcc does not provide.
+ */
+static inline bool
+int128_mul_pow10_overflow(INT128 *i128, int k)
+{
+	/* limits[k] = floor((2^127 - 1) / 10^k), as {high, low} 64-bit halves */
+	static const uint64 limits[INT128_POW10_MAX + 1][2] = {
+		{UINT64CONST(0x7FFFFFFFFFFFFFFF), UINT64CONST(0xFFFFFFFFFFFFFFFF)},
+		{UINT64CONST(0x0CCCCCCCCCCCCCCC), UINT64CONST(0xCCCCCCCCCCCCCCCC)},
+		{UINT64CONST(0x0147AE147AE147AE), UINT64CONST(0x147AE147AE147AE1)},
+		{UINT64CONST(0x0020C49BA5E353F7), UINT64CONST(0xCED916872B020C49)},
+		{UINT64CONST(0x000346DC5D638865), UINT64CONST(0x94AF4F0D844D013A)},
+		{UINT64CONST(0x000053E2D6238DA3), UINT64CONST(0xC21187E7C06E19B9)},
+		{UINT64CONST(0x000008637BD05AF6), UINT64CONST(0xC69B5A63F9A49C2C)},
+		{UINT64CONST(0x000000D6BF94D5E5), UINT64CONST(0x7A42BC3D32907604)},
+		{UINT64CONST(0x00000015798EE230), UINT64CONST(0x8C39DF9FB841A566)},
+		{UINT64CONST(0x0000000225C17D04), UINT64CONST(0xDAD2965CC5A02A23)},
+		{UINT64CONST(0x0000000036F9BFB3), UINT64CONST(0xAF7B756FAD5CD103)},
+		{UINT64CONST(0x00000000057F5FF8), UINT64CONST(0x5E592557F7BC7B4D)},
+		{UINT64CONST(0x00000000008CBCCC), UINT64CONST(0x096F5088CBF93F87)},
+		{UINT64CONST(0x00000000000E12E1), UINT64CONST(0x3424BB40E132865A)},
+		{UINT64CONST(0x0000000000016849), UINT64CONST(0xB86A12B9B01EA709)},
+		{UINT64CONST(0x0000000000002407), UINT64CONST(0x5F3DCEAC2B3643E7)},
+		{UINT64CONST(0x000000000000039A), UINT64CONST(0x5652FB1137856D30)},
+		{UINT64CONST(0x000000000000005C), UINT64CONST(0x3BD5191B525A2484)},
+		{UINT64CONST(0x0000000000000009), UINT64CONST(0x392EE8E921D5D073)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0xEC1E4A7DB69561A5)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x179CA10C9242235D)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x025C768141D369EF)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x003C7240202EBDCB)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00060B6CD004AC94)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00009ABE14CD4475)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00000F79687AED3E)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000018C240C4AEC)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x000000279D346DE4)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00000003F61ED7CA)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000000065697BFA)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x000000000A2425FF)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000000001039D66)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x000000000019F623)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x000000000002989D)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000000000004276)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00000000000006A5)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x00000000000000AA)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000000000000011)},
+		{UINT64CONST(0x0000000000000000), UINT64CONST(0x0000000000000001)}
+	};
+
+	Assert(k >= 0);
+
+	if (k == 0 || int128_is_zero(*i128))
+		return false;
+	if (k > INT128_POW10_MAX)
+		return true;
+
+#if USE_NATIVE_INT128
+	{
+		int128		limit = make_int128((int64) limits[k][0], limits[k][1]);
+		int128		result = *i128;
+
+		if (result > limit || result < -limit)
+			return true;
+
+		/* the bound holds, so no partial product can overflow */
+		while (k > 0)
+		{
+			int			chunk = Min(k, INT64_POW10_MAX);
+
+			result *= pow10_int64[chunk];
+			k -= chunk;
+		}
+		*i128 = result;
+	}
+#else
+	{
+		static const uint32 pow10_32[] = {
+			1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000,
+			1000000000
+		};
+		bool		neg = (i128->hi < 0);
+		uint64		abs_hi = (uint64) i128->hi;
+		uint64		abs_lo = i128->lo;
+
+		/* magnitude; for -2^127 this is 2^127, still representable here */
+		if (neg)
+		{
+			abs_lo = 0 - abs_lo;
+			abs_hi = 0 - abs_hi - (abs_lo != 0);
+		}
+
+		if (abs_hi > limits[k][0] ||
+			(abs_hi == limits[k][0] && abs_lo > limits[k][1]))
+			return true;
+
+		/*
+		 * Multiply the magnitude by 10^k in chunks that fit in uint32, using
+		 * 32-bit-limb schoolbook multiplication.  The bound above guarantees
+		 * that nothing carries out of the top limb.
+		 */
+		while (k > 0)
+		{
+			int			chunk = Min(k, 9);
+			uint64		m = pow10_32[chunk];
+			uint64		r0,
+						r1,
+						r2,
+						r3;
+
+			r0 = (abs_lo & UINT64CONST(0xFFFFFFFF)) * m;
+			r1 = (abs_lo >> 32) * m + (r0 >> 32);
+			r2 = (abs_hi & UINT64CONST(0xFFFFFFFF)) * m + (r1 >> 32);
+			r3 = (abs_hi >> 32) * m + (r2 >> 32);
+			Assert((r3 >> 31) == 0);
+
+			abs_lo = (r1 << 32) | (r0 & UINT64CONST(0xFFFFFFFF));
+			abs_hi = (r3 << 32) | (r2 & UINT64CONST(0xFFFFFFFF));
+			k -= chunk;
+		}
+
+		if (neg)
+		{
+			abs_lo = 0 - abs_lo;
+			abs_hi = 0 - abs_hi - (abs_lo != 0);
+		}
+		i128->hi = (int64) abs_hi;
+		i128->lo = abs_lo;
+	}
+#endif
+	return false;
+}
+
 #endif							/* INT128_H */
diff --git a/src/test/modules/test_int128/test_int128.c b/src/test/modules/test_int128/test_int128.c
index 8f230f3937b..efff4060e68 100644
--- a/src/test/modules/test_int128/test_int128.c
+++ b/src/test/modules/test_int128/test_int128.c
@@ -68,6 +68,147 @@ my_int128_compare(int128 x, int128 y)
 	return 0;
 }
 
+#define MAX128	((int128) ((~(uint128) 0) >> 1))	/* 2^127 - 1 */
+#define MIN128	(-MAX128 - 1)	/* -2^127 */
+
+/*
+ * Check int128_add_int128_overflow(x, y) against the expected outcome.  On
+ * overflow the accumulator must be left unchanged.
+ */
+static bool
+check_add_overflow(int128 x, int128 y, bool exp_ovf)
+{
+	test128		a;
+	test128		b;
+	test128		expected;
+	bool		got_ovf;
+
+	a.i128 = x;
+	b.i128 = y;
+	expected.i128 = exp_ovf ? x : x + y;
+
+	got_ovf = int128_add_int128_overflow(&a.I128, b.I128);
+	if (got_ovf != exp_ovf || a.i128 != expected.i128)
+	{
+		b.i128 = x;
+		printf(INT128_HEX_FORMAT " +ovf ", b.hl.hi, b.hl.lo);
+		b.i128 = y;
+		printf(INT128_HEX_FORMAT "\n", b.hl.hi, b.hl.lo);
+		printf("expected ovf=%d " INT128_HEX_FORMAT "\n",
+			   exp_ovf, expected.hl.hi, expected.hl.lo);
+		printf("result   ovf=%d " INT128_HEX_FORMAT "\n",
+			   got_ovf, a.hl.hi, a.hl.lo);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Check int128_mul_pow10_overflow(x, k) against the expected outcome.  On
+ * overflow the accumulator must be left unchanged.
+ */
+static bool
+check_mul_pow10_overflow(int128 x, int k, bool exp_ovf)
+{
+	test128		a;
+	test128		expected;
+	bool		got_ovf;
+
+	a.i128 = x;
+	expected.i128 = x;
+	if (!exp_ovf && x != 0)
+	{
+		for (int i = 0; i < k; i++)
+			expected.i128 *= 10;
+	}
+
+	got_ovf = int128_mul_pow10_overflow(&a.I128, k);
+	if (got_ovf != exp_ovf || a.i128 != expected.i128)
+	{
+		test128		t;
+
+		t.i128 = x;
+		printf(INT128_HEX_FORMAT " * 10^%d\n", t.hl.hi, t.hl.lo, k);
+		printf("expected ovf=%d " INT128_HEX_FORMAT "\n",
+			   exp_ovf, expected.hl.hi, expected.hl.lo);
+		printf("result   ovf=%d " INT128_HEX_FORMAT "\n",
+			   got_ovf, a.hl.hi, a.hl.lo);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Deterministic boundary checks for the overflow-checked operations, hitting
+ * the exact edges that random inputs will practically never find.
+ */
+static bool
+check_overflow_boundaries(void)
+{
+	int128		p10 = 1;
+
+	/* addition at both ends of the range */
+	if (!check_add_overflow(MAX128, 1, true) ||
+		!check_add_overflow(MAX128, -1, false) ||
+		!check_add_overflow(MAX128, 0, false) ||
+		!check_add_overflow(MAX128, MAX128, true) ||
+		!check_add_overflow(MIN128, -1, true) ||
+		!check_add_overflow(MIN128, 1, false) ||
+		!check_add_overflow(MIN128, 0, false) ||
+		!check_add_overflow(MIN128, MIN128, true) ||
+		!check_add_overflow(MIN128, MAX128, false) ||
+		!check_add_overflow(-1, MIN128, true) ||
+		!check_add_overflow(1, MAX128, true))
+		return false;
+
+	/* k = 0 is a no-op even at the extremes */
+	if (!check_mul_pow10_overflow(MAX128, 0, false) ||
+		!check_mul_pow10_overflow(MIN128, 0, false))
+		return false;
+
+	/* zero stays zero for any exponent, including ones beyond 38 */
+	if (!check_mul_pow10_overflow(0, 1, false) ||
+		!check_mul_pow10_overflow(0, 38, false) ||
+		!check_mul_pow10_overflow(0, 39, false) ||
+		!check_mul_pow10_overflow(0, 1000, false))
+		return false;
+
+	/* any nonzero value overflows beyond 10^38 */
+	if (!check_mul_pow10_overflow(1, 38, false) ||
+		!check_mul_pow10_overflow(-1, 38, false) ||
+		!check_mul_pow10_overflow(10, 38, true) ||
+		!check_mul_pow10_overflow(-10, 38, true) ||
+		!check_mul_pow10_overflow(1, 39, true) ||
+		!check_mul_pow10_overflow(-1, 39, true) ||
+		!check_mul_pow10_overflow(1, 1000, true))
+		return false;
+
+	/*
+	 * For every exponent, the largest and smallest values that still fit,
+	 * and their neighbours just outside.  C division truncates toward zero,
+	 * so MIN128 / p10 is the smallest multiplicand that fits.
+	 */
+	for (int k = 1; k <= 38; k++)
+	{
+		int128		hi_lim;
+		int128		lo_lim;
+
+		p10 *= 10;
+		hi_lim = MAX128 / p10;
+		lo_lim = MIN128 / p10;
+
+		if (!check_mul_pow10_overflow(hi_lim, k, false) ||
+			!check_mul_pow10_overflow(hi_lim + 1, k, true) ||
+			!check_mul_pow10_overflow(lo_lim, k, false) ||
+			!check_mul_pow10_overflow(lo_lim - 1, k, true) ||
+			!check_mul_pow10_overflow(MAX128, k, true) ||
+			!check_mul_pow10_overflow(MIN128, k, true))
+			return false;
+	}
+
+	return true;
+}
+
 /*
  * Main program.
  *
@@ -88,6 +229,9 @@ main(int argc, char **argv)
 	else
 		count = 1000000000;
 
+	if (!check_overflow_boundaries())
+		return 1;
+
 	while (count-- > 0)
 	{
 		int64		x = pg_prng_int64(&pg_global_prng_state);
@@ -212,6 +356,84 @@ main(int argc, char **argv)
 			return 1;
 		}
 
+		/* check overflow-checked 128-bit addition */
+		t1.hl.hi = x;
+		t1.hl.lo = y;
+		t2 = t1;
+		t3.hl.hi = z;
+		t3.hl.lo = w;
+		{
+			/* reference result via wrap-around-safe unsigned arithmetic */
+			test128		expected;
+			bool		exp_ovf;
+			bool		got_ovf;
+
+			expected.i128 = (int128) ((uint128) t1.i128 + (uint128) t3.i128);
+			exp_ovf = ((t1.i128 < 0) == (t3.i128 < 0) &&
+					   (expected.i128 < 0) != (t1.i128 < 0));
+			if (exp_ovf)
+				expected = t1;	/* accumulator must stay unchanged */
+
+			got_ovf = int128_add_int128_overflow(&t2.I128, t3.I128);
+
+			if (got_ovf != exp_ovf ||
+				t2.hl.hi != expected.hl.hi || t2.hl.lo != expected.hl.lo)
+			{
+				printf(INT128_HEX_FORMAT " +ovf " INT128_HEX_FORMAT "\n", x, y, z, w);
+				printf("expected ovf=%d " INT128_HEX_FORMAT "\n",
+					   exp_ovf, expected.hl.hi, expected.hl.lo);
+				printf("result   ovf=%d " INT128_HEX_FORMAT "\n",
+					   got_ovf, t2.hl.hi, t2.hl.lo);
+				return 1;
+			}
+		}
+
+		/* check overflow-checked multiplication by 10^k */
+		t1.hl.hi = x;
+		t1.hl.lo = y;
+		t2 = t1;
+		{
+			int			k = (int) (pg_prng_uint32(&pg_global_prng_state) % 39);
+			int128		p10 = 1;
+			test128		expected;
+			bool		exp_ovf;
+			bool		got_ovf;
+
+			for (int i = 0; i < k; i++)
+				p10 *= 10;
+
+			/*
+			 * A random 128-bit operand overflows for practically every k > 0,
+			 * so on every other iteration shrink it into the range where the
+			 * product fits, to exercise the non-overflow path as well.
+			 */
+			if (z & 1)
+			{
+				t1.i128 /= p10;
+				t2 = t1;
+			}
+
+			exp_ovf = (t1.i128 != 0 && k > 0 &&
+					   (t1.i128 > MAX128 / p10 || t1.i128 < MIN128 / p10));
+			if (exp_ovf)
+				expected = t1;
+			else
+				expected.i128 = t1.i128 * p10;
+
+			got_ovf = int128_mul_pow10_overflow(&t2.I128, k);
+
+			if (got_ovf != exp_ovf ||
+				t2.hl.hi != expected.hl.hi || t2.hl.lo != expected.hl.lo)
+			{
+				printf(INT128_HEX_FORMAT " * 10^%d\n", t1.hl.hi, t1.hl.lo, k);
+				printf("expected ovf=%d " INT128_HEX_FORMAT "\n",
+					   exp_ovf, expected.hl.hi, expected.hl.lo);
+				printf("result   ovf=%d " INT128_HEX_FORMAT "\n",
+					   got_ovf, t2.hl.hi, t2.hl.lo);
+				return 1;
+			}
+		}
+
 		/* check 128/32-bit division */
 		t3.hl.hi = x;
 		t3.hl.lo = y;
-- 
