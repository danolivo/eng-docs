From 7430e1d2742ef1642e926a54599a060973f11522 Mon Sep 17 00:00:00 2001
From: "Andrei V. Lepikhov" <lepihov@gmail.com>
Date: Mon, 10 Aug 2026 20:17:30 +0200
Subject: [PATCH v0 03/10] Unpack short numerics on the stack in arithmetic and
 aggregation

Earlier commits removed the per-call DatumGetNumeric() copy from the numeric
hash and comparison functions.  The same copy remains in two other hot paths:
numeric_avg_accum() and numeric_accum() detoast their input once per row, and
numeric_add/sub/mul/div do it twice per operation.  Values arriving from a tuple
carry a one-byte varlena header, so each of those is a palloc'd copy that lives
only for the duration of the call.

Use numeric_unpack_local() at those call sites too.  None of the callees retains
its argument -- the arithmetic workers read the operands through
init_var_from_num() and build a fresh result, and the aggregate transition
copies digits into the accumulator -- so a caller-stack buffer serves, with
DatumGetNumeric() still handling compressed and out-of-line values.

The aggregate transitions gain the most, because for a plain aggregate over a
stored column that per-row copy is a larger share of the work than the
accumulation arithmetic around it.  Instructions retired, counted under
callgrind, fall 14.9% for both sum(numeric) and avg(numeric), and 8.1%, 8.1% and
7.5% for sums of a+b, a*b and a/b over stored operands.  In wall-clock terms
over ten million rows, medians of eleven runs, measured against the preceding
commit: sum 537 -> 402 ms, avg 534 -> 399 ms, and a moving-window sum over a
hundred-row frame -- which calls the forward and the inverse transition once per
row each -- 4017 -> 3641 ms.  The three arithmetic queries improve by 6.2%, 8.5%
and 6.6%.

How much an expression gains depends on where its operands come from, and the
spread is wide enough to be worth stating.  An operand read from a column has
the one-byte header this optimises; the result of enclosing arithmetic is
already palloc'd with a four-byte header and gains nothing.  A TPC-H-derived Q1
at scale factor 10, whose sums multiply computed intermediates, improves by
1.2%, against 24% for a sum taken straight over a column.
---
 src/backend/utils/adt/numeric.c | 87 ++++++++++++++++++++++++++++-----
 1 file changed, 76 insertions(+), 11 deletions(-)

diff --git a/src/backend/utils/adt/numeric.c b/src/backend/utils/adt/numeric.c
index 897c25e9d7b..b64f25a0af4 100644
--- a/src/backend/utils/adt/numeric.c
+++ b/src/backend/utils/adt/numeric.c
@@ -3050,12 +3050,21 @@ hash_numeric_extended(PG_FUNCTION_ARGS)
 Datum
 numeric_add(PG_FUNCTION_ARGS)
 {
-	Numeric		num1 = PG_GETARG_NUMERIC(0);
-	Numeric		num2 = PG_GETARG_NUMERIC(1);
+	NumericLocalBuf buf1;
+	NumericLocalBuf buf2;
+	bool		free1;
+	bool		free2;
+	Numeric		num1 = numeric_unpack_local(PG_GETARG_DATUM(0), &buf1, &free1);
+	Numeric		num2 = numeric_unpack_local(PG_GETARG_DATUM(1), &buf2, &free2);
 	Numeric		res;
 
 	res = numeric_add_safe(num1, num2, NULL);
 
+	if (unlikely(free1))
+		pfree(num1);
+	if (unlikely(free2))
+		pfree(num2);
+
 	PG_RETURN_NUMERIC(res);
 }
 
@@ -3125,12 +3134,21 @@ numeric_add_safe(Numeric num1, Numeric num2, Node *escontext)
 Datum
 numeric_sub(PG_FUNCTION_ARGS)
 {
-	Numeric		num1 = PG_GETARG_NUMERIC(0);
-	Numeric		num2 = PG_GETARG_NUMERIC(1);
+	NumericLocalBuf buf1;
+	NumericLocalBuf buf2;
+	bool		free1;
+	bool		free2;
+	Numeric		num1 = numeric_unpack_local(PG_GETARG_DATUM(0), &buf1, &free1);
+	Numeric		num2 = numeric_unpack_local(PG_GETARG_DATUM(1), &buf2, &free2);
 	Numeric		res;
 
 	res = numeric_sub_safe(num1, num2, NULL);
 
+	if (unlikely(free1))
+		pfree(num1);
+	if (unlikely(free2))
+		pfree(num2);
+
 	PG_RETURN_NUMERIC(res);
 }
 
@@ -3201,12 +3219,21 @@ numeric_sub_safe(Numeric num1, Numeric num2, Node *escontext)
 Datum
 numeric_mul(PG_FUNCTION_ARGS)
 {
-	Numeric		num1 = PG_GETARG_NUMERIC(0);
-	Numeric		num2 = PG_GETARG_NUMERIC(1);
+	NumericLocalBuf buf1;
+	NumericLocalBuf buf2;
+	bool		free1;
+	bool		free2;
+	Numeric		num1 = numeric_unpack_local(PG_GETARG_DATUM(0), &buf1, &free1);
+	Numeric		num2 = numeric_unpack_local(PG_GETARG_DATUM(1), &buf2, &free2);
 	Numeric		res;
 
 	res = numeric_mul_safe(num1, num2, fcinfo->context);
 
+	if (unlikely(free1))
+		pfree(num1);
+	if (unlikely(free2))
+		pfree(num2);
+
 	if (unlikely(SOFT_ERROR_OCCURRED(fcinfo->context)))
 		PG_RETURN_NULL();
 
@@ -3323,12 +3350,21 @@ numeric_mul_safe(Numeric num1, Numeric num2, Node *escontext)
 Datum
 numeric_div(PG_FUNCTION_ARGS)
 {
-	Numeric		num1 = PG_GETARG_NUMERIC(0);
-	Numeric		num2 = PG_GETARG_NUMERIC(1);
+	NumericLocalBuf buf1;
+	NumericLocalBuf buf2;
+	bool		free1;
+	bool		free2;
+	Numeric		num1 = numeric_unpack_local(PG_GETARG_DATUM(0), &buf1, &free1);
+	Numeric		num2 = numeric_unpack_local(PG_GETARG_DATUM(1), &buf2, &free2);
 	Numeric		res;
 
 	res = numeric_div_safe(num1, num2, NULL);
 
+	if (unlikely(free1))
+		pfree(num1);
+	if (unlikely(free2))
+		pfree(num2);
+
 	PG_RETURN_NUMERIC(res);
 }
 
@@ -5171,7 +5207,17 @@ numeric_accum(PG_FUNCTION_ARGS)
 		state = makeNumericAggState(fcinfo, true);
 
 	if (!PG_ARGISNULL(1))
-		do_numeric_accum(state, PG_GETARG_NUMERIC(1));
+	{
+		NumericLocalBuf buf;
+		bool		needfree;
+		Numeric		newval = numeric_unpack_local(PG_GETARG_DATUM(1), &buf,
+												  &needfree);
+
+		do_numeric_accum(state, newval);
+
+		if (unlikely(needfree))
+			pfree(newval);
+	}
 
 	PG_RETURN_POINTER(state);
 }
@@ -5271,7 +5317,17 @@ numeric_avg_accum(PG_FUNCTION_ARGS)
 		state = makeNumericAggState(fcinfo, false);
 
 	if (!PG_ARGISNULL(1))
-		do_numeric_accum(state, PG_GETARG_NUMERIC(1));
+	{
+		NumericLocalBuf buf;
+		bool		needfree;
+		Numeric		newval = numeric_unpack_local(PG_GETARG_DATUM(1), &buf,
+												  &needfree);
+
+		do_numeric_accum(state, newval);
+
+		if (unlikely(needfree))
+			pfree(newval);
+	}
 
 	PG_RETURN_POINTER(state);
 }
@@ -5599,8 +5655,17 @@ numeric_accum_inv(PG_FUNCTION_ARGS)
 
 	if (!PG_ARGISNULL(1))
 	{
+		NumericLocalBuf buf;
+		bool		needfree;
+		Numeric		newval = numeric_unpack_local(PG_GETARG_DATUM(1), &buf,
+												  &needfree);
+		bool		ok = do_numeric_discard(state, newval);
+
+		if (unlikely(needfree))
+			pfree(newval);
+
 		/* If we fail to perform the inverse transition, return NULL */
-		if (!do_numeric_discard(state, PG_GETARG_NUMERIC(1)))
+		if (!ok)
 			PG_RETURN_NULL();
 	}
 
