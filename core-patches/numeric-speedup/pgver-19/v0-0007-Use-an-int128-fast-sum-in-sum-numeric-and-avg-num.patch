+SET LOCAL min_eager_agg_group_size = 0;
+SET LOCAL max_parallel_workers_per_gather = 0;
+EXPLAIN (COSTS OFF)
+SELECT m.fgrp, sum(t.v), avg(t.v)
+FROM num_fast_agg t JOIN num_fast_agg_map m ON t.grp = m.k
