+/*
+ * The conversions below between a NumericVar and a scaled int128 coefficient
+ * hard-wire the decimal shifts of one, two and three positions within a
+ * base-NBASE digit, so they are written for DEC_DIGITS == 4 only.  With any
+ * other NBASE the int128 representation is not used at all: aggregate states
+ * are created promoted (see makeNumericAggState()), and
+ * numericvar_to_int128_scaled() rejects every value, so that a deserialized
+ * state is promoted as well and int128_to_numericvar_scaled() is never
+ * reached.
+ */
+
+/*
+ * Convert a finite NumericVar into an int128 coefficient at decimal scale
+ * 'scale', so that the value equals result * 10^(-scale).
+ *
+ * Returns false, leaving *result untouched, whenever the conversion cannot
+ * be done cheaply and exactly: the coefficient is wider than the lanes below
+ * handle (more than INT128_POW10_MAX decimal digits, counting the leading
+ * base-NBASE digit in full, or more than the int64 lane without native
+ * int128), the requested scale is below the value's dscale, or the stored
+ * digits carry nonzero positions beyond dscale (which the dscale invariant
+ * forbids, but we refuse to trust data with exactness).  Callers treat false
+ * as "use the digit-array representation instead", so a rejection is always
+ * safe.
+ *
+ * No allocation is performed; the var's digits are read in place, so a
+ * zero-copy view from init_var_from_num() works fine.
+ *
+ * This runs once per input row in the transition functions.  Having more
+ * than one call site, it is not inlined by the compiler on its own, so force
+ * inlining.  Callers off the per-row path should use
+ * numericvar_to_int128_scaled_noinline() instead, so that they do not carry
+ * a copy of this function each.
+ */
+static pg_attribute_always_inline bool
+numericvar_to_int128_scaled(const NumericVar *var, int scale, INT128 *result)
+{
+#if DEC_DIGITS == 4
+	int			shift;
+
+	Assert(var->sign == NUMERIC_POS || var->sign == NUMERIC_NEG);
+	Assert(scale >= 0);
+
+	/* a zero stores no digits and converts exactly at any scale */
+	if (var->ndigits == 0)
+	{
+		*result = int64_to_int128(0);
+		return true;
+	}
+
+	/* never scale down below the value's own display scale */
+	if (scale < var->dscale)
+		return false;
+
+	/*
+	 * Width cap: the coefficient has at most (weight + 1) * DEC_DIGITS +
+	 * scale decimal digits, and nothing wider than INT128_POW10_MAX is
+	 * accepted below.
+	 *
+	 * (weight + 1) * DEC_DIGITS + scale is the same quantity as ndigits *
+	 * DEC_DIGITS + shift, the number of decimal digits the lanes below have
+	 * to produce.  Checking it here rejects pathologically wide values (huge
+	 * weight, huge scale) before shift is even computed, and it is the bound
+	 * the int128 lane relies on.
+	 */
+	if ((var->weight + 1) * DEC_DIGITS + scale > INT128_POW10_MAX)
+		return false;
+
+	shift = scale - (var->ndigits - var->weight - 1) * DEC_DIGITS;
+
+	/*
+	 * Int64 lane for the overwhelmingly common case: up to 4 stored digits
+	 * (16 decimal digits) whose scaled coefficient provably fits int64. This
+	 * avoids all 128-bit multiplications on the per-row path.  The bounds
+	 * make every operation overflow-free by construction: 4 digits <= 10^16 -
+	 * 1, times 10^shift <= 10^INT64_POW10_MAX.
+	 *
+	 * Note that a negative shift is the common shape, not the corner: a
+	 * numeric(15,2) value stores its fraction inside one base-NBASE digit,
+	 * overshooting dscale by two decimal positions.
+	 */
+	if (var->ndigits <= 4 &&
+		var->ndigits * DEC_DIGITS + (shift > 0 ? shift : 0) <= INT64_POW10_MAX)
+	{
+		int64		acc64 = 0;
+
+		for (int i = 0; i < var->ndigits; i++)
+			acc64 = acc64 * NBASE + var->digits[i];
+		if (shift > 0)
+			acc64 *= pow10_int64[shift];
+		else if (shift < 0)
+		{
+			/*
+			 * Constant divisors per case, so the compiler strength-reduces
+			 * the divisions to multiplications.  The overshoot digits must be
+			 * zeroes (see the dscale-invariant note in the header comment); a
+			 * nonzero remainder makes the value ineligible.
+			 */
+			switch (shift)
+			{
+				case -1:
+					if (acc64 % 10 != 0)
+						return false;
+					acc64 /= 10;
+					break;
+				case -2:
+					if (acc64 % 100 != 0)
+						return false;
+					acc64 /= 100;
+					break;
+				case -3:
+					if (acc64 % 1000 != 0)
+						return false;
+					acc64 /= 1000;
+					break;
+				default:
+					/* stored digits beyond dscale + 3: invariant violated */
+					return false;
+			}
+		}
+		if (var->sign == NUMERIC_NEG)
+			acc64 = -acc64;
+		*result = int64_to_int128(acc64);
+		return true;
+	}
+
+#if USE_NATIVE_INT128
+
+	/*
+	 * Native int128 lane for wider values: coefficients of up to
+	 * INT128_POW10_MAX decimal digits.  The width cap above keeps the result
+	 * below 10^INT128_POW10_MAX < 2^127, and no intermediate value exceeds
+	 * the result in magnitude, so no operation can overflow and no checked
+	 * arithmetic is needed.  The overshoot below dscale lives in the last
+	 * stored digit, so it is checked and dropped there, with a constant
+	 * divisor per case.
+	 *
+	 * The lane takes any value whose overshoot stays within the last stored
+	 * digit, which holds for every normalized value.  Together with the cap,
+	 * this bounds the number of stored digits, and so the loop below: there
+	 * are at most 10 of them, the tenth only when the last one overshoots the
+	 * scale by two or three positions.  A numeric(38,2) value at full width
+	 * has that shape.
+	 *
+	 * The cap bounds an upward shift as well, at INT128_POW10_MAX -
+	 * DEC_DIGITS positions for a single stored digit.  That is more than the
+	 * int64 power-of-ten table spans, but less than twice its span, so a long
+	 * shift is applied in two steps.  Integer values need one at a display
+	 * scale above INT64_POW10_MAX, and so do round integers with more
+	 * trailing zeroes than that.
+	 */
+	if (shift > -DEC_DIGITS)
+	{
+		int128		a = 0;
+		int			last = var->digits[var->ndigits - 1];
+
+		Assert(var->ndigits * DEC_DIGITS + shift <= INT128_POW10_MAX);
+
+		for (int i = 0; i < var->ndigits - 1; i++)
+			a = a * NBASE + var->digits[i];
+
+		switch (shift)
+		{
+			case -1:
+				if (last % 10 != 0)
+					return false;
+				a = a * (NBASE / 10) + last / 10;
+				break;
+			case -2:
+				if (last % 100 != 0)
+					return false;
+				a = a * (NBASE / 100) + last / 100;
+				break;
+			case -3:
+				if (last % 1000 != 0)
+					return false;
+				a = a * (NBASE / 1000) + last / 1000;
+				break;
+			default:
+				Assert(shift >= 0);
+				a = a * NBASE + last;
+				if (shift > INT64_POW10_MAX)
+				{
+					a *= pow10_int64[INT64_POW10_MAX];
+					shift -= INT64_POW10_MAX;
+				}
+				Assert(shift <= INT64_POW10_MAX);
+				a *= pow10_int64[shift];
+				break;
+		}
+		*result = (var->sign == NUMERIC_NEG) ? -a : a;
+		return true;
+	}
+#endif
+
+	/*
+	 * Anything wider (or, without native int128, anything beyond the int64
+	 * lane) is left to the digit-array accumulator.  A checked per-digit
+	 * 128-bit conversion is deliberately not attempted: it would cost more
+	 * than the accumulator it replaces.
+	 */
+	return false;
+#else
+	/* no int128 conversions for this NBASE: nothing is eligible */
+	return false;
+#endif							/* DEC_DIGITS == 4 */
+}
+
+/*
+ * Out-of-line version of numericvar_to_int128_scaled(), for callers that run
+ * once per aggregate state rather than once per input row.
+ */
+static pg_noinline bool
+numericvar_to_int128_scaled_noinline(const NumericVar *var, int scale,
+									 INT128 *result)
+{
+	return numericvar_to_int128_scaled(var, scale, result);
+}
+
+/*
+ * Convert an int128 coefficient at decimal scale 'scale' into a NumericVar,
+ * the exact inverse of numericvar_to_int128_scaled().
+ *
+ * The resulting var's dscale is 'scale'.  When scale is not a multiple of
+ * DEC_DIGITS, the lowest base-NBASE digit straddles the decimal point; we
+ * peel it off with a division by the appropriate power of ten, which is
+ * exact for every int128 value (multiplying the coefficient up instead
+ * could overflow near the range limits).
+ */
+static void
+int128_to_numericvar_scaled(INT128 val, int scale, NumericVar *var)
+{
+#if DEC_DIGITS == 4
+	int			pad = (DEC_DIGITS - (scale % DEC_DIGITS)) % DEC_DIGITS;
+	int			frac_ndigits = (scale + pad) / DEC_DIGITS;
+	NumericDigit *ptr;
+	int			ndigits;
+	int32		dig;
+	int			sign = int128_sign(val);
+
+	Assert(scale >= 0);
+
+	/* a zero stores no digits, so it needs no digit buffer either */
+	if (sign == 0)
+	{
+		zero_var(var);
+		var->dscale = scale;
+		return;
+	}
+
+	/*
+	 * An int128 spans at most INT128_POW10_MAX + 1 decimal digits; the
+	 * straddling digit can add one more base-NBASE digit, so 11 digits always
+	 * suffice.
+	 */
+	alloc_var(var, (INT128_POW10_MAX + 1 + DEC_DIGITS - 1) / DEC_DIGITS + 1);
+	var->sign = sign < 0 ? NUMERIC_NEG : NUMERIC_POS;
+	var->dscale = scale;
+	ptr = var->digits + var->ndigits;
+	ndigits = 0;
+
+	/*
+	 * Int64 lane: group sums usually still fit int64, which spares the
+	 * 128-bit divisions.  Finalization runs once per group, so this is the
+	 * hot path when groups are many and small.
+	 */
+	if (int128_compare(val, int64_to_int128(int128_to_int64(val))) == 0)
+	{
+		int64		v64 = int128_to_int64(val);
+		uint64		u = (v64 < 0) ? 0 - (uint64) v64 : (uint64) v64;
+
+		if (pad > 0)
+		{
+			/*
+			 * Take DEC_DIGITS - pad decimal digits into the lowest base-NBASE
+			 * digit and shift them up by 'pad' zero positions.
+			 *
+			 * With constant divisors per case the compiler strength-reduces
+			 * the 64-bit divisions to multiplications.
+			 */
+			ptr--;
+			ndigits++;
+			switch (pad)
+			{
+				case 1:
+					*ptr = (NumericDigit) ((u % 1000) * 10);
+					u /= 1000;
+					break;
+				case 2:
+					*ptr = (NumericDigit) ((u % 100) * 100);
+					u /= 100;
+					break;
+				case 3:
+					*ptr = (NumericDigit) ((u % 10) * 1000);
+					u /= 10;
+					break;
+				default:
+					pg_unreachable();
+			}
+		}
+		while (u != 0)
+		{
+			ptr--;
+			ndigits++;
+			*ptr = (NumericDigit) (u % NBASE);
+			u /= NBASE;
+		}
+	}
+	else
+	{
+		if (pad > 0)
+		{
+			/* as above, but on the full 128-bit value */
+			int128_div_mod_int32(&val, pow10_int32[DEC_DIGITS - pad], &dig);
+			ptr--;
+			ndigits++;
+			*ptr = (NumericDigit) (abs(dig) * pow10_int32[pad]);
+		}
+		while (!int128_is_zero(val))
+		{
+			int128_div_mod_int32(&val, NBASE, &dig);
+			ptr--;
+			ndigits++;
+			*ptr = (NumericDigit) abs(dig);
+		}
+	}
+
+	var->digits = ptr;
+	var->ndigits = ndigits;
+	var->weight = ndigits - 1 - frac_ndigits;
+#else
+	/* no state ever holds an int128 sum for this NBASE */
+	elog(ERROR, "int128 sum representation requires DEC_DIGITS == 4");
+#endif							/* DEC_DIGITS == 4 */
+}
